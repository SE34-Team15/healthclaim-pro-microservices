datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  CLAIM_OFFICER
  FINANCE_MANAGER
  SYSTEM_ADMIN
  SECURITY_AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ClaimCategory {
  CONSULTATION
  MEDICATION
  SURGERY
  HOSPITALIZATION
  DENTAL
  OPTICAL
  HEALTH_SCREENING
  OTHER
}

enum ClaimStatus {
  SUBMITTED
  AUTO_VALIDATED
  FLAGGED_REVIEW
  OFFICER_APPROVED
  OFFICER_REJECTED
  FINANCE_APPROVED
  SETTLED
  CANCELLED
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            Role              @default(EMPLOYEE)
  status          UserStatus        @default(ACTIVE)
  department      String?
  isEmailVerified Boolean           @default(false)
  
  quotas          UserPolicyQuota[]
  claims          Claim[]
  auditLogs       AuditLog[]
  attachments     ReceiptAttachment[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
  @@index([role])
}

model BenefitTier {
  id                String            @id @default(uuid())
  name              String            @unique
  code              String            @unique
  description       String?
  annualLimit       Decimal           @db.Decimal(12, 2)
  defaultDeductible Decimal           @db.Decimal(12, 2)
  defaultCoPayRate  Decimal           @db.Decimal(5, 4)
  isActive          Boolean           @default(true)
  
  userQuotas        UserPolicyQuota[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model UserPolicyQuota {
  id                       String       @id @default(uuid())
  userId                   String
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefitTierId            String
  benefitTier              BenefitTier  @relation(fields: [benefitTierId], references: [id])
  fiscalYear               Int
  annualLimit              Decimal      @db.Decimal(12, 2)
  remainingBalance         Decimal      @db.Decimal(12, 2)
  cumulativeDeductibleSpent Decimal      @default(0) @db.Decimal(12, 2)
  
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([userId, fiscalYear])
  @@index([userId])
  @@index([benefitTierId])
}

model Claim {
  id                 String              @id @default(uuid())
  claimNumber        String              @unique
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fiscalYear         Int
  category           ClaimCategory
  hospitalName       String
  hospitalGrade      String?             @default("GRADE_A")
  invoiceDate        DateTime
  totalAmount        Decimal             @db.Decimal(12, 2)
  deductibleCovered  Decimal             @default(0) @db.Decimal(12, 2)
  coPayRate          Decimal             @db.Decimal(5, 4)
  approvedAmount     Decimal             @default(0) @db.Decimal(12, 2)
  outOfPocketAmount  Decimal             @default(0) @db.Decimal(12, 2)
  status             ClaimStatus         @default(SUBMITTED)
  statusReason       String?
  reviewedBy         String?
  reviewedAt         DateTime?
  notes              String?
  
  items              ClaimItem[]
  ruleEvaluations    RuleEvaluationLog[]
  attachments        ReceiptAttachment[]
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([claimNumber])
  @@index([fiscalYear])
}

model ClaimItem {
  id              String        @id @default(uuid())
  claimId         String
  claim           Claim         @relation(fields: [claimId], references: [id], onDelete: Cascade)
  description     String
  category        ClaimCategory
  unitPrice       Decimal       @db.Decimal(12, 2)
  quantity        Int           @default(1)
  totalPrice      Decimal       @db.Decimal(12, 2)
  isEligible      Boolean       @default(true)
  rejectionReason String?
  
  createdAt       DateTime      @default(now())

  @@index([claimId])
}

model ReceiptAttachment {
  id           String   @id @default(uuid())
  claimId      String?
  claim        Claim?   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileSize     Int
  mimeType     String
  storageKey   String   @unique
  encryptedDek String?  // AES-256-GCM DEK encrypted with Master RSA/ECC Key
  iv           String?  // 12-byte initialization vector hex
  authTag      String?  // 16-byte GCM authentication tag hex
  checksum     String   // SHA-256 integrity hash
  magicHeader  String?  @default("HC_ENC") // Custom binary magic header
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([claimId])
  @@index([userId])
  @@index([storageKey])
}

model ComplianceRule {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  description    String?
  priority       Int                 @default(100)
  astDefinition  Json
  isActive       Boolean             @default(true)
  
  evaluationLogs RuleEvaluationLog[]
  
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([code])
  @@index([isActive])
}

model RuleEvaluationLog {
  id             String         @id @default(uuid())
  claimId        String
  claim          Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ruleId         String?
  rule           ComplianceRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleCode       String
  ruleName       String
  isPassed       Boolean
  reason         String?
  details        Json?
  evaluatedAt    DateTime       @default(now())

  @@index([claimId])
  @@index([ruleId])
}

model AuditLog {
  id               String   @id @default(uuid())
  actorId          String?
  actor            User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action           String
  targetResource   String
  targetResourceId String?
  details          Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// TODO: Reserved for future Email Verification module
model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}
