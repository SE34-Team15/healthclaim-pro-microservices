# ==============================================================================
# HealthClaim Pro - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://healthclaim_user:healthclaim_pass@localhost:5432/healthclaim_db?schema=public

# Distributed Caching (Redis 7)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Distributed Messaging & Domain Events (RabbitMQ)
RABBITMQ_URL=amqp://healthclaim_mq:healthclaim_mq_pass@localhost:5672
RABBITMQ_EXCHANGE=healthclaim.events

# Microservice Endpoints (For Gateway Ingress Routing)
CLAIM_SERVICE_URL=http://localhost:3001
RULE_ENGINE_SERVICE_URL=http://localhost:3002
ACTUARIAL_SERVICE_URL=http://localhost:3003

# JWT Security Configuration
JWT_SECRET=super_secret_healthclaim_pro_jwt_key_development_2026!
JWT_EXPIRES_IN=7d

# TODO: SMTP Email Gateway Configuration (Reserved for notification and email verification)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@healthclaim.pro
SMTP_SECURE=false

# Object Storage (S3 / MinIO) Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=healthclaim-receipts
S3_SETTLEMENT_BUCKET=healthclaim-settlements
S3_FORCE_PATH_STYLE=true
