# ==============================================================================
# HealthClaim Pro - Kubernetes Secrets Template
# ==============================================================================
# SECURITY NOTICE:
# DO NOT COMMIT PRODUCTION SECRETS TO VERSION CONTROL!
# Production secrets are securely stored in AWS SSM Parameter Store under /healthclaim/prod/*
# and injected into Kubernetes via:
#
#   k3s kubectl create secret generic healthclaim-secrets -n healthclaim \
#     --from-literal=DATABASE_URL="postgresql://<user>:<password>@healthclaim-postgres:5432/healthclaim_db?schema=public" \
#     --from-literal=JWT_SECRET="<generate-with-openssl-rand-hex-32>" \
#     --from-literal=MASTER_ENCRYPTION_KEY="<generate-with-openssl-rand-hex-32>" \
#     --from-literal=RABBITMQ_URL="amqp://<mq-user>:<mq-password>@healthclaim-rabbitmq:5672" \
#     --from-literal=S3_ACCESS_KEY="<minio-access-key>" \
#     --from-literal=S3_SECRET_KEY="<minio-secret-key>" \
#     --from-literal=RESEND_API_KEY="<resend-api-key>" \
#     --dry-run=client -o yaml | k3s kubectl apply -f -
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: healthclaim-secrets
  namespace: healthclaim
type: Opaque
stringData:
  DATABASE_URL: "postgresql://<DB_USER>:<DB_PASSWORD>@healthclaim-postgres:5432/healthclaim_db?schema=public"
  JWT_SECRET: "<GENERATE_256_BIT_HEX_HASH_VIA_OPENSSL>"
  MASTER_ENCRYPTION_KEY: "<GENERATE_256_BIT_HEX_HASH_VIA_OPENSSL>"
  RABBITMQ_URL: "amqp://<MQ_USER>:<MQ_PASSWORD>@healthclaim-rabbitmq:5672"
  S3_ACCESS_KEY: "<MINIO_ACCESS_KEY>"
  S3_SECRET_KEY: "<MINIO_SECRET_KEY>"
  RESEND_API_KEY: "<RESEND_API_KEY>"
